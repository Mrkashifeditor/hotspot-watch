# hotspot-watch — .env.example
# Copy to .env and fill in. NEVER commit .env (see .gitignore).
# The router eWeb password is the password you use to log in at
# https://192.168.111.1 — it stays on your own Pi/PC only.
ROUTER_PASSWORD=
# Optional overrides:
# ROUTER_HOST=192.168.111.1
# ROUTER_SCHEME=https
